# Environment Configuration
NODE_ENV=development
PORT=8000
VERTICAL=core

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# TWO roles, on purpose. RLS is silently inert for any role holding BYPASSRLS,
# which is the default for managed-Postgres owner accounts, so the runtime must
# NOT connect as the owner. See DEPLOY.md → "Tenant isolation: the two-role setup".
#
#   DATABASE_URL      owner role — migrations / DDL only
#   DATABASE_APP_URL  meru_app (NOBYPASSRLS) — application runtime
#
# Create the app role and write DATABASE_APP_URL here with:
#   node scripts/provision-rls-role.js --write-env
# Then prove isolation holds:  npm run rls:verify
DATABASE_URL=postgresql://<owner>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_APP_URL=postgresql://meru_app:<password>@<host>.neon.tech/<db>?sslmode=require
# Password used by provision-rls-role.js when creating meru_app
MERU_APP_PASSWORD=

# Discrete vars — only used as a fallback when DATABASE_URL is unset (local Postgres)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=meru_core

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=1h

# Shared secret for the Vercel Cron entrypoints (src/jobs). Sent as
# `Authorization: Bearer <CRON_SECRET>`; the endpoints 401 without it.
CRON_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_GLOBAL=100
RATE_LIMIT_MAX_IMMIGRATION=100
RATE_LIMIT_MAX_BANKING=50

# ─── Cache (optional) ────────────────────────────────────────────────────────
# Redis is NOT required. The job queue is Postgres-backed (`queue_jobs`), and
# these vars only select the cache store — unset means in-memory.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
# Enables pgvector-backed semantic search alongside BM25
ENABLE_SEMANTIC_SEARCH=false

# ─── Mail (Resend) ───────────────────────────────────────────────────────────
# Transactional email: workspace welcome, user invites, password resets.
# Without RESEND_API_KEY the app still works — messages are logged in full
# (including action links) and reported as `delivered: false` rather than
# silently dropped. Set both before relying on delivery.
RESEND_API_KEY=
# Must be an address on a domain verified in your Resend account. The default
# (onboarding@resend.dev) is Resend's sandbox sender and only delivers to the
# account owner.
RESEND_FROM=Meru <noreply@yourdomain.com>
# Base URL the invite / reset / login / onboarding links point at. This is a
# link a CUSTOMER clicks, so it must be a hostname that resolves and serves the
# app the link's path exists in. `app.meru.com` is NXDOMAIN (workspace
# CLAUDE.md §4) — it was the old default here and produced dead invites.
APP_URL=https://app.immistack.com

# ─── AWS (S3 document storage only — mail is Resend, above) ──────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=meru-documents
# Optional: pull DB credentials from Secrets Manager instead of the vars above

# ─── Documents ───────────────────────────────────────────────────────────────
DOCUMENT_ENCRYPTION_KEY=your-32-character-encryption-key-here
MAX_FILE_SIZE=52428800

# ─── Local development helpers ───────────────────────────────────────────────
# Skip boot-time seeding of packages/config-packs into the config_packs table
SKIP_CONFIG_PACK_LOADER=false
# TenantContextMiddleware reads these when the Host header is localhost
TEST_ENV=development
TEST_VERTICAL=immigration
# Password for the accounts created by scripts/seed-demo.js
DEMO_PASSWORD=

# ── Object storage ─────────────────────────────────────────────────────────
# Two drivers exist and each registers only when its own credentials are set
# (src/storage/storage.module.ts). With exactly one credentialed driver the
# registry selects it automatically; with two, STORAGE_PROVIDER must choose.
#
# S3 driver — also serves any S3-compatible store (Supabase Storage, R2,
# Wasabi, MinIO). AWS_S3_ENDPOINT is what makes that work: without it the SDK
# resolves s3.<region>.amazonaws.com and a Supabase key pair fails as an
# "invalid access key" error that points nowhere near the real cause.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
AWS_S3_ENDPOINT=

# Supabase driver — native, needs a service-role key rather than an S3 pair.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
