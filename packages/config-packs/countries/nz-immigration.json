  "alertRules": [
    {
      "key": "nz_medical_expiring",
      "label": "INZ medical certificate is valid for 36 months — 3 months remain",
      "entityType": "case",
      "when": {
        ">": [
          {
            "var": "matter.medicalCertificate_daysSince"
          },
          1005
        ]
      },
      "severity": "warning",
      "notifyRoles": [
        "migration_agent",
        "firm_admin"
      ],
      "createTask": true,
      "cooldownHours": 168,
      "escalateAfterHours": 336,
      "escalateToRoles": [
        "firm_admin"
      ]
    },
    {
      "key": "nz_police_certificate_expiring",
      "label": "Police certificate is valid for 24 months — 3 months remain",
      "entityType": "case",
      "when": {
        ">": [
          {
            "var": "matter.policeCertificate_daysSince"
          },
          640
        ]
      },
      "severity": "warning",
      "notifyRoles": [
        "migration_agent",
        "firm_admin"
      ],
      "createTask": true,
      "cooldownHours": 168,
      "escalateAfterHours": 336,
      "escalateToRoles": [
        "firm_admin"
      ]
    },
    {
      "key": "nz_visa_expiring",
      "label": "Visa expiring — applying before expiry avoids an interim visa period",
      "entityType": "case",
      "when": {
        "and": [
          {
            "<": [
              {
                "var": "matter.visaExpiry_daysUntil"
              },
              60
            ]
          },
          {
            ">=": [
              {
                "var": "matter.visaExpiry_daysUntil"
              },
              0
            ]
          }
        ]
      },
      "severity": "critical",
      "notifyRoles": [
        "migration_agent",
        "firm_admin"
      ],
      "createTask": true,
      "cooldownHours": 72,
      "escalateAfterHours": 168,
      "escalateToRoles": [
        "firm_admin"
      ]
    }
  ],
  "metadata": {
    "alertRulesReview": "Authored from published guidance and MUST be confirmed by a registered practitioner for this jurisdiction before a firm relies on them. Every rule fires EARLIER than the deadline it watches, so a wrong threshold surfaces work sooner rather than missing it. The variables are the ones RuleEvaluatorService actually derives — `<dateField>_daysUntil` and `_daysSince` — because a threshold baked into the variable name resolves to undefined and the rule silently never fires. The matter must carry these date attributes for the rules to have anything to read."
  }
}
